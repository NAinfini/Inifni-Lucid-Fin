{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@lucid-fin/contracts": ["../../packages/contracts/src/index.ts"],
      "@lucid-fin/contracts/canonical-json": ["../../packages/contracts/src/canonical-json.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.*"],
  "references": [{ "path": "../../packages/contracts" }]
}
