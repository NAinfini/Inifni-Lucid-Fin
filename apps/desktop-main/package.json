{
  "name": "@lucid-fin/desktop-main",
  "version": "0.1.0",
  "description": "Lucid Fin – Electron main process",
  "author": {
    "name": "NAinfini",
    "email": "na.infini@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "repository": "github:NAinfini/Inifni-Lucid-Fin",
  "type": "module",
  "main": "dist/electron.js",
  "scripts": {
    "dev": "tsc && tsc -p tsconfig.preload.json && node -e \"const { spawn } = require('node:child_process'); delete process.env.ELECTRON_RUN_AS_NODE; const child = spawn(require('electron'), ['dist/electron.js'], { stdio: 'inherit', env: process.env }); child.on('exit', (code, signal) => process.exit(code ?? (signal ? 1 : 0)));\"",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.preload.tsbuildinfo",
    "build": "rimraf dist tsconfig.tsbuildinfo tsconfig.preload.tsbuildinfo && tsc && tsc -p tsconfig.preload.json",
    "pack:renderer": "pnpm --filter @lucid-fin/desktop-renderer run build",
    "pack": "pnpm run build && pnpm run pack:renderer && electron-builder --config electron-builder.json",
    "pack:win": "pnpm run pack -- --win",
    "pack:mac": "pnpm run pack -- --mac",
    "pack:linux": "pnpm run pack -- --linux",
    "rebuild": "electron-rebuild"
  },
  "dependencies": {
    "@lucid-fin/adapters-ai": "workspace:*",
    "@lucid-fin/application": "workspace:*",
    "@lucid-fin/contracts": "workspace:*",
    "@lucid-fin/contracts-parse": "workspace:*",
    "@lucid-fin/domain": "workspace:*",
    "@lucid-fin/media-engine": "workspace:*",
    "@lucid-fin/shared-utils": "workspace:*",
    "@lucid-fin/storage": "workspace:*",
    "@lucid-fin/target-contracts": "workspace:*",
    "@lucid-fin/target-runtime": "workspace:*",
    "@lucid-fin/target-storage": "workspace:*",
    "@openai/codex": "0.145.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.2",
    "electron-log": "^5.4.4",
    "fluent-ffmpeg": "^2.1.3",
    "keytar": "^7.9.0",
    "pdfkit": "^0.19.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.145.0-darwin-arm64",
    "@openai/codex-darwin-x64": "npm:@openai/codex@0.145.0-darwin-x64",
    "@openai/codex-linux-arm64": "npm:@openai/codex@0.145.0-linux-arm64",
    "@openai/codex-linux-x64": "npm:@openai/codex@0.145.0-linux-x64",
    "@openai/codex-win32-arm64": "npm:@openai/codex@0.145.0-win32-arm64",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.145.0-win32-x64"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/archiver": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "typescript": "^6.0.2"
  }
}
