{
  "name": "lucid-fin",
  "version": "0.1.0",
  "description": "Lucid Fin – AI Movie Production Tool",
  "author": "Lucid Fin Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26.5.1",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "pnpm run build && pnpm --filter @lucid-fin/desktop-renderer run build:dev && pnpm --filter @lucid-fin/desktop-main run dev",
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.performance.config.ts",
    "test:types": "pnpm -r exec tsc --noEmit && tsc --noEmit -p apps/desktop-main/tsconfig.preload.json",
    "electron:install": "node scripts/install-electron.mjs",
    "postinstall": "node scripts/install-electron.mjs",
    "lint": "eslint . && pnpm run lint:contracts",
    "lint:contracts": "tsx scripts/generate-contracts.ts --check",
    "format": "prettier \"**/*\" --write --ignore-unknown",
    "format:check": "prettier \"**/*\" --check --ignore-unknown",
    "check:production-closure": "tsx scripts/check-production-closure.ts",
    "license:audit": "tsx scripts/license-audit.ts",
    "dist": "pnpm run build && pnpm --filter @lucid-fin/desktop-main run pack",
    "audit:uncommitted": "tsx scripts/audit-uncommitted.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
